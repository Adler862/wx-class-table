<!-- pages/index/index.wxml - 课表展示页（6大节 × 7天） -->
<view class="container">

  <!-- 顶部周次切换栏 -->
  <view class="week-bar">
    <view class="week-btn" bindtap="prevWeek">
      <text class="arrow">◀</text>
    </view>
    <view class="week-info">
      <text class="week-label">第</text>
      <input class="week-input" type="number" value="{{currentWeek}}" min="1" max="{{maxWeek}}" bindconfirm="onWeekInputChange" />
      <text class="week-label">周</text>
    </view>
    <view class="week-btn" bindtap="nextWeek">
      <text class="arrow">▶</text>
    </view>
    <view class="week-today" bindtap="jumpToCurrentWeek">
      <text>今</text>
    </view>
  </view>

  <!-- 快捷操作栏 -->
  <view class="action-bar">
    <view class="action-item" bindtap="goToAdd">
      <text class="action-icon">＋</text>
      <text class="action-text">添加课程</text>
    </view>
    <view class="action-item" bindtap="importExcelFile">
      <text class="action-icon">📥</text>
      <text class="action-text">导入课表</text>
    </view>
    <view class="action-item" bindtap="showSemesterSetting">
      <text class="action-icon">📅</text>
      <text class="action-text">学期设置</text>
    </view>
    <view class="action-item clear" bindtap="clearAllCourses">
      <text class="action-icon">🗑</text>
      <text class="action-text">清除全部</text>
    </view>
  </view>

  <!-- 课表表格（6大节×7天） -->
  <scroll-view scroll-x class="table-scroll" wx:if="{{hasCourses}}">
    <view class="schedule-table">

      <!-- 表头：星期 -->
      <view class="table-row table-header">
        <view class="cell section-header">节次/时间</view>
        <view class="cell day-header" wx:for="{{weekDays}}" wx:key="*this">
          <text class="day-name">{{item}}</text>
          <text class="day-date">{{weekDates[index]}}</text>
        </view>
      </view>

      <!-- 课表主体：6大节 × 7天 -->
        <view class="table-row" wx:for="{{scheduleGrid}}" wx:key="index" wx:for-index="sectionIdx" wx:for-item="rowData">
          <!-- 节次信息列 -->
          <view class="cell section-cell">
            <text class="section-name">{{periodSections[sectionIdx].section}}</text>
            <text class="section-time">{{periodSections[sectionIdx].time}}</text>
            <text class="section-subs">{{periodSections[sectionIdx].subs}}小节</text>
          </view>

          <!-- 一周七天 -->
          <block wx:for="{{rowData}}" wx:key="index" wx:for-index="col" wx:for-item="cellData">
            <!-- 有课程的格子 -->
            <view wx:if="{{cellData.courses.length > 0}}" class="cell course-cell">
              <view wx:for="{{cellData.courses}}" wx:key="id" wx:for-index="ci" wx:for-item="course" class="course-item" style="background:{{course.color}};" data-day="{{col}}" data-section="{{sectionIdx}}" data-cindex="{{ci}}" bindtap="onCourseTap">
                <text class="course-name">{{course.name}}</text>
                <text class="course-location" wx:if="{{course.location}}">{{course.location}}</text>
                <view class="course-tags">
                  <text class="course-badge odd" wx:if="{{course.weekType === 'odd'}}">单</text>
                  <text class="course-badge even" wx:if="{{course.weekType === 'even'}}">双</text>
                  <text class="course-badge note" wx:if="{{course.note}}">{{course.note}}</text>
                </view>
              </view>
            </view>
            <!-- 空格子 -->
            <view wx:else class="cell empty-cell"></view>
          </block>
        </view>

      </view>
  </scroll-view>

  <!-- 空课表 -->
  <view class="empty-state" wx:if="{{!hasCourses}}">
    <view class="empty-icon">📚</view>
    <text class="empty-title">还没有课程</text>
    <text class="empty-desc">从教务处下载课表Excel文件\n直接导入即可</text>
    <view class="empty-actions">
      <button class="empty-btn primary" bindtap="importExcelFile">📥 导入教务处课表</button>
      <button class="empty-btn" bindtap="goToAdd">＋ 手动添加课程</button>
    </view>
  </view>

</view>

<!-- ==================== 课程详情弹窗 ==================== -->
<view class="modal-overlay" wx:if="{{showDetail}}" bindtap="closeDetail" catchtouchmove="preventTouchMove">
  <view class="modal-content" catchtap="preventTouchMove">
    <view class="modal-header">
      <text class="modal-title">课程详情</text>
      <view class="modal-close" bindtap="closeDetail">✕</view>
    </view>

    <view class="detail-body" wx:if="{{detailCourse}}">
      <view class="detail-item">
        <text class="detail-label">课程名称</text>
        <text class="detail-value name">{{detailCourse.name}}</text>
      </view>
      <view class="detail-item" wx:if="{{detailCourse.note}}">
        <text class="detail-label">备注</text>
        <text class="detail-value note-val">{{detailCourse.note}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">授课教师</text>
        <text class="detail-value">{{detailCourse.teacher || '未填写'}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">上课地点</text>
        <text class="detail-value">{{detailCourse.location || '未填写'}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">上课时间</text>
        <text class="detail-value">周{{detailCourse.day}} 第{{detailCourse.startPeriod}}-{{detailCourse.endPeriod}}节</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">教学周次</text>
        <text class="detail-value">
          <block wx:if="{{detailCourse.weeks && detailCourse.weeks.length > 0}}">
            第{{detailCourse.weeks[0]}}-{{detailCourse.weeks[detailCourse.weeks.length-1]}}周
            ({{detailCourse.weeks.length}}次课)
          </block>
          <block wx:else>
            第{{detailCourse.startWeek}}周起，共{{detailCourse.totalWeeks}}周
            <text wx:if="{{detailCourse.weekType === 'odd'}}">（仅单周）</text>
            <text wx:if="{{detailCourse.weekType === 'even'}}">（仅双周）</text>
          </block>
        </text>
      </view>
    </view>

    <view class="modal-actions">
      <button class="modal-btn edit" bindtap="editCourse">✎ 编辑</button>
      <button class="modal-btn delete" bindtap="deleteCourse">✕ 删除</button>
    </view>
  </view>
</view>

<!-- ==================== 学期设置弹窗 ==================== -->
<view class="modal-overlay" wx:if="{{showSemesterSetting}}" bindtap="closeSemesterSetting" catchtouchmove="preventTouchMove">
  <view class="modal-content" catchtap="preventTouchMove">
    <view class="modal-header">
      <text class="modal-title">学期设置</text>
    </view>
    <view class="semester-body">
      <text class="semester-label">选择本学期第一天的日期：</text>
      <picker mode="date" value="{{semesterStart}}" bindchange="onSemesterDateChange">
        <view class="date-picker">
          <text wx:if="{{semesterStart}}">{{semesterStart}}</text>
          <text wx:else class="placeholder">请选择日期</text>
        </view>
      </picker>
      <text class="semester-hint">设置后将自动计算当前教学周</text>
    </view>
    <view class="modal-actions">
      <view class="modal-btn cancel" bindtap="closeSemesterSetting">取消</view>
      <view class="modal-btn edit" bindtap="saveSemester">确定</view>
    </view>
  </view>
</view>

<!-- 底部栏 -->
<view class="bottom-bar" wx:if="{{hasCourses}}">
  <text class="bottom-text">共 {{allCoursesCount}} 门课程 · 第 {{currentWeek}} 周</text>
</view>