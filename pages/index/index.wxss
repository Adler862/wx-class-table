/* pages/index/index.wxss - 6大节×7天课表 */

.container { padding-bottom: 120rpx; }

/* ========== 周次栏 ========== */
.week-bar {
  display: flex; align-items: center; justify-content: center;
  height: 96rpx; background: #fff; border-bottom: 1rpx solid #eee;
  position: sticky; top: 0; z-index: 100;
}
.week-btn {
  width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #f0f0f0;
}
.week-btn:active { background: #e0e0e0; }
.arrow { font-size: 24rpx; color: #666; }
.week-info { display: flex; align-items: center; margin: 0 24rpx; }
.week-label { font-size: 30rpx; color: #333; font-weight: 500; }
.week-input {
  width: 80rpx; height: 60rpx; border: 2rpx solid #7f8c8d; border-radius: 8rpx;
  text-align: center; font-size: 30rpx; color: #7f8c8d; font-weight: 600; margin: 0 8rpx;
}
.week-today {
  width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #7f8c8d; color: #fff; font-size: 22rpx; font-weight: 600; margin-left: 16rpx;
}

/* ========== 操作栏 ========== */
.action-bar { display: flex; background: #fff; padding: 16rpx 24rpx; margin-bottom: 8rpx; }
.action-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; border-right: 1rpx solid #f0f0f0; }
.action-item:last-child { border-right: none; }
.action-icon { font-size: 36rpx; margin-bottom: 4rpx; }
.action-text { font-size: 22rpx; color: #666; }
.action-item.clear .action-text { color: #e74c3c; }

/* ========== 表格 ========== */
.table-scroll { width: 100%; white-space: normal; }
.schedule-table { display: inline-block; min-width: 100%; }
.table-row { display: flex; border-bottom: 1rpx solid #eee; }
.table-header { background: #7f8c8d; color: #fff; font-weight: 600; font-size: 26rpx; }
.cell { width: 140rpx; min-width: 140rpx; box-sizing: border-box; }

/* 大节头 */
.section-header {
  width: 160rpx; min-width: 160rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 16rpx 8rpx; color: #fff; font-size: 24rpx;
}
.day-header {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 10rpx 4rpx; border-left: 1rpx solid rgba(255,255,255,0.2);
}
.day-date {
  font-size: 20rpx; font-weight: 400; opacity: 0.85; margin-top: 4rpx;
}
/* 大节信息列 */
.section-cell {
  width: 160rpx; min-width: 160rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 20rpx 8rpx; background: #fafafa; border-right: 1rpx solid #eee;
}
.section-name { font-size: 24rpx; color: #7f8c8d; font-weight: 700; }
.section-time { font-size: 20rpx; color: #666; margin-top: 4rpx; }
.section-subs { font-size: 18rpx; color: #aaa; margin-top: 2rpx; }

/* 课程格子 */
.course-cell {
  padding: 6rpx; border-left: 1rpx solid #eee;
  display: flex; flex-direction: column; gap: 6rpx;
}
.course-item {
  display: flex; flex-direction: column; justify-content: center;
  padding: 12rpx 0rpx; border-radius: 8rpx; min-height: 180rpx;
}
.course-item:active { opacity: 0.75; }
.course-name {
  font-size: 24rpx; font-weight: 600; color: #333;
  text-align: center; line-height: 1.3;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; word-break: break-all;
}
.course-location {
  font-size: 18rpx; color: #888; margin-top: 4rpx; text-align: center;
  overflow: hidden; text-overflow: ellipsis; white-space: normal;
}
.course-tags { display: flex; justify-content: center; gap: 4rpx; margin-top: 4rpx; flex-wrap: wrap; }
.course-badge {
  font-size: 16rpx; padding: 1rpx 8rpx; border-radius: 4rpx;
}
.course-badge.odd { background: rgba(127,140,141,0.12); color: #7f8c8d; }
.course-badge.even { background: rgba(229,57,53,0.12); color: #e53935; }
.course-badge.note { background: rgba(76,175,80,0.12); color: #4caf50; }

/* 空格子 */
.empty-cell { height: 210rpx; border-left: 1rpx solid #fafafa; background: #fff; }

/* ========== 空状态 ========== */
.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 120rpx 60rpx; text-align: center;
}
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.empty-desc { font-size: 26rpx; color: #999; line-height: 1.6; margin-bottom: 48rpx; white-space: pre-line; }
.empty-actions { display: flex; flex-direction: column; gap: 16rpx; width: 100%; }
.empty-btn {
  width: 100%; height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx; font-size: 28rpx; border: 2rpx solid #7f8c8d; color: #7f8c8d; background: #fff;
}
.empty-btn.primary { background: #7f8c8d; color: #fff; border: none; }

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.modal-content {
  width: 600rpx; max-height: 80vh; background: #fff;
  border-radius: 24rpx; overflow: hidden;
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx; border-bottom: 1rpx solid #f0f0f0;
}
.modal-title { font-size: 32rpx; font-weight: 700; color: #333; }
.modal-close {
  width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #f5f5f5; font-size: 28rpx; color: #999;
}
.modal-actions { display: flex; padding: 24rpx 32rpx; gap: 16rpx; border-top: 1rpx solid #f0f0f0; }
.modal-btn {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 12rpx; font-size: 28rpx; font-weight: 500; border: none;
}
.modal-btn.edit { background: #7f8c8d; color: #fff; }
.modal-btn.delete { background: #e53935; color: #fff; }
.modal-btn.cancel { background: #f0f0f0; color: #666; }

/* 详情 */
.detail-body { padding: 32rpx; max-height: 50vh; overflow-y: auto; }
.detail-item { display: flex; flex-direction: column; margin-bottom: 28rpx; }
.detail-item:last-child { margin-bottom: 0; }
.detail-label { font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.detail-value { font-size: 28rpx; color: #333; line-height: 1.5; }
.detail-value.name { font-size: 34rpx; font-weight: 700; color: #7f8c8d; }
.detail-value.note-val { color: #4caf50; }

/* 学期设置 */
.semester-body { padding: 40rpx 32rpx; }
.semester-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 20rpx; }
.date-picker {
  width: 100%; height: 80rpx; display: flex; align-items: center;
  padding: 0 24rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx;
  font-size: 28rpx; color: #333; box-sizing: border-box;
}
.date-picker .placeholder { color: #ccc; }
.semester-hint { font-size: 22rpx; color: #999; margin-top: 16rpx; display: block; }

/* 底部栏 */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  background: #fff; border-top: 1rpx solid #f0f0f0; z-index: 50;
}
.bottom-text { font-size: 24rpx; color: #999; }
